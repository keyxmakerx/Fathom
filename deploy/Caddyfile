# Caddy terminates TLS in front of fathom-server, and serves the built
# client -- the same site, the same certificate, the same port.
#
# THIS FILE IS WHY C7 SURVIVES. `49` §6 keeps "no C or C++ in the shipped
# closure" only if TLS is terminated in front of the binary, because rustls's
# crypto provider (`ring` or `aws-lc-sys`) brings C and assembly back in.
# `deny.toml` bans all four carriers by name; this file is the other half of
# that decision — the part that makes the ban survivable.
#
# `tls internal` uses Caddy's own CA, which is right for a local bring-up and
# for the WO-11 §6 G7 drive. A real deployment replaces this block with a real
# host name and lets Caddy get a certificate, or points at files.

{
	auto_https disable_redirects
	admin off
}

# `localhost:8443`, not a bare `:8443`. With `tls internal` and no host name in
# the site address, Caddy has no name to issue a certificate FOR, and the
# handshake fails with a TLS internal error rather than anything that names the
# cause -- found 2026-09-03 by running this file. A real deployment replaces
# `localhost` with the real host name and drops `tls internal` so Caddy gets a
# publicly trusted certificate.
localhost:8443 {
	tls internal

	header {
		# Nothing here served HTML when this line was first written; it does
		# now (the client, below), which is exactly why a header that applies
		# to the whole site rather than one handler is worth having.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output stdout
		format json
	}

	# EVERY PATH FATHOM-SERVER ACTUALLY ROUTES ON, AND NOTHING ELSE.
	# Enumerated from its own routers -- `crates/fathom-server/src/api.rs`,
	# `design_api.rs`, `admin.rs`, `firmware.rs`, and `lib.rs`'s own
	# `router()` (`lib.rs` ~L126, `/health` and `/schema/kinds`) -- rather
	# than a wildcard, for the same reason `client/vite.config.ts`'s dev-time
	# proxy gives for making the identical choice: "a wildcard proxy here
	# would silently forward requests to endpoints that do not exist yet."
	# Widen this the same day that list is widened, from the same source.
	@api path /session /session/* /organisations /organisations/* /catalogue/* /admin/* /enrolment/* /firmware/* /health /schema/kinds

	# `handle` blocks are mutually exclusive in Caddy's own routing model --
	# the first whose matcher fires wins and the rest are skipped, which is
	# what makes a matcher-less `handle` below a true catch-all rather than a
	# second thing that always also runs.
	handle @api {
		reverse_proxy server:8080 {
			# WITHOUT THIS LINE, CADDY ALREADY DISCARDS AN INCOMING
			# X-Forwarded-For -- this line is belt and braces, not the only
			# guard. Caddy's own doc: "For these X-Forwarded-* headers, by
			# default, the proxy will ignore their values from incoming
			# requests, to prevent spoofing"
			# (caddyserver.com/docs/caddyfile/directives/reverse_proxy, read
			# 2026-09-19; an earlier version of this comment misquoted this
			# page and said the opposite). With no `trusted_proxies`
			# configured here, Caddy's own source
			# (`addForwardedHeaders`, modules/caddyhttp/reverseproxy/reverseproxy.go,
			# read the same day) deletes an incoming X-Forwarded-For outright
			# and sets it fresh from the connection's own peer address, so
			# this `header_up` is a second, independent way to guarantee the
			# same outcome for a deployment that is a single hop (client →
			# Caddy → server, `compose.yaml`'s own header: "the server
			# is not published to the host; only Caddy is"), not a fix for a
			# default that appends. `fathom-server` reads the LAST entry of a
			# trusted header regardless (`crates/fathom-server/src/api.rs::source_of`
			# gives the fuller reasoning, including why last is also right on
			# a deployment that does append).
			header_up X-Forwarded-For {remote_host}
		}
	}

	# The client. Built by `deploy/Dockerfile`'s `client-build` stage and
	# baked into this image's `/srv/www` by its `caddy` stage -- see that
	# file for why baked in rather than a bind mount (the build needs `npm`,
	# and this image does not carry one).
	#
	# No `try_files … /index.html` fallback yet: the client has no
	# client-side router as of this change (`docs/RUNNING-IT.md`'s Compose
	# section says so), so there is no second URL that should ever resolve to
	# `index.html`. A later slice that adds client-side routing adds the
	# fallback here in the same change.
	handle {
		root * /srv/www
		file_server
	}
}
