# Caddy terminates TLS in front of fathom-server.
#
# THIS FILE IS WHY C7 SURVIVES. `49` §6 keeps "no C or C++ in the shipped
# closure" only if TLS is terminated in front of the binary, because rustls's
# crypto provider (`ring` or `aws-lc-sys`) brings C and assembly back in.
# `deny.toml` bans all four carriers by name; this file is the other half of
# that decision — the part that makes the ban survivable.
#
# `tls internal` uses Caddy's own CA, which is right for a local bring-up and
# for the WO-11 §6 G7 drive. A real deployment replaces this block with a real
# host name and lets Caddy get a certificate, or points at files.

{
	auto_https disable_redirects
	admin off
}

# `localhost:8443`, not a bare `:8443`. With `tls internal` and no host name in
# the site address, Caddy has no name to issue a certificate FOR, and the
# handshake fails with a TLS internal error rather than anything that names the
# cause -- found 2026-09-03 by running this file. A real deployment replaces
# `localhost` with the real host name and drops `tls internal` so Caddy gets a
# publicly trusted certificate.
localhost:8443 {
	tls internal

	# TWO HANDLERS, AND THE SPLIT IS TEMPORARY. `/health` is the server's only
	# route today (`crates/fathom-server/src/lib.rs`: "The router. One
	# endpoint."). Everything else is the browser product, baked into this
	# image by the Dockerfile's `web` stage.
	#
	# As the server grows routes, they move from the second handler to the
	# first. When it serves the application itself, the second handler and the
	# `web` stage both go, and this file returns to a single reverse_proxy.
	handle /health {
		# The server is not published to the host at all, so this is the only
		# way in.
		reverse_proxy server:8080
	}

	handle {
		root * /srv
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# NO Content-Security-Policy HEADER HERE, DELIBERATELY. The artifact is one
	# self-contained file with inline script and style, and it carries its own
	# CSP in a meta tag — the transcript face reads that CSP off the live page
	# and shows it. A header set here would either duplicate that or silently
	# override it, and the page would break in a way whose cause is invisible.
	# If a CSP belongs at the edge, it has to be reconciled with the artifact's
	# own, which is a decision and not a header.

	log {
		output stdout
		format json
	}
}
