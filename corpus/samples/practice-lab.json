  "mistakes": [
    {
      "rule": "l2.vlan.access-mismatch",
      "where": "switch-1:7",
      "what": "The office run joins switch-1 port 7 (VLAN 10) to switch-2 port 1 (VLAN 30)."
    },
    {
      "rule": "ip.address.network-or-broadcast",
      "where": "printer-1:eth0",
      "what": "printer-1 is given 192.168.10.255, the broadcast address of its subnet."
    },
    {
      "rule": "ip.address.different-subnet-on-link",
      "where": "switch-1:1",
      "what": "switch-1's management address, 192.168.1.254, is on a different network from router-1's 192.168.10.1 at the other end of the same cable."
    }
  ]
