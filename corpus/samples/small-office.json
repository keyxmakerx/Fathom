    {
      "prefix": "192.168.10.0/24",
      "gateway": "192.168.10.1",
      "hosts": [
        {
          "port": "ap-1:1",
          "address": "192.168.10.5/24"
        },
        {
          "port": "nas-1:1",
          "address": "192.168.10.10/24"
        },
        {
          "port": "desktop-1:eth0",
          "address": "192.168.10.50/24"
        },
        {
          "port": "printer-1:eth0",
          "address": "192.168.10.60/24"
        }
      ]
    },
    {
      "prefix": "192.168.30.0/24",
      "gateway": "192.168.30.1",
      "hosts": [
        {
          "port": "camera-1:eth0",
          "address": "192.168.30.21/24"
        },
        {
          "port": "camera-2:eth0",
          "address": "192.168.30.22/24"
        }
      ]
    }
  ],
  "configs": [
    {
      "device": "fw-1",
      "platform": "junos-srx",
      "ties": {
        "ge-0/0/0": "0",
        "ge-0/0/1": "1",
        "ge-0/0/2": "2"
      },
      "lines": [
        "set system host-name fw-1",
        "set interfaces ge-0/0/0 unit 0 family inet address 203.0.113.2/30",
        "set interfaces ge-0/0/1 unit 0 family inet address 192.168.10.1/24",
        "set interfaces ge-0/0/2 unit 0 family inet address 192.168.30.1/24",
        "set routing-options static route 0.0.0.0/0 next-hop 203.0.113.1",
        "set security zones security-zone untrust interfaces ge-0/0/0.0",
        "set security zones security-zone trust interfaces ge-0/0/1.0",
        "set security zones security-zone cameras interfaces ge-0/0/2.0",
        "set security policies from-zone trust to-zone untrust policy office-out match source-address any",
        "set security policies from-zone trust to-zone untrust policy office-out match destination-address any",
        "set security policies from-zone trust to-zone untrust policy office-out match application any",
        "set security policies from-zone trust to-zone untrust policy office-out then permit",
        "set security policies from-zone trust to-zone cameras policy block-cameras match source-address any",
        "set security policies from-zone trust to-zone cameras policy block-cameras match destination-address any",
        "set security policies from-zone trust to-zone cameras policy block-cameras match application any",
        "set security policies from-zone trust to-zone cameras policy block-cameras then deny",
        "set security policies from-zone trust to-zone cameras policy allow-viewer match source-address any",
        "set security policies from-zone trust to-zone cameras policy allow-viewer match destination-address any",
        "set security policies from-zone trust to-zone cameras policy allow-viewer match application junos-rtsp",
        "set security policies from-zone trust to-zone cameras policy allow-viewer then permit"
      ]
    }
  ],
  "trace": {
    "from": "desktop-1",
    "to": "nas-1"
  }
}
