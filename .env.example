# Copy to `.env` and fill in the one line that has no default. `docker compose`
# reads this file from the directory it runs in.

# The address operator notices go to. Recorded at first start, once, and it
# cannot be changed afterwards (docs/OPERATING.md, "The operator notice
# address"). There is deliberately no default: a guessed address would create
# an operator nobody can reach.
FATHOM_OPERATOR_NOTICE_ADDRESS=

# The one published port, plain HTTP, for your reverse proxy to point at.
# Optional. Publish it where only the proxy reaches it: 127.0.0.1 if the proxy
# runs on this machine outside Docker; this host's NetBird address if the
# proxy is NetBird's; leave it alone if the proxy reaches the port over
# Docker's own network.
#FATHOM_PORT=8080
#FATHOM_PUBLISH_ADDRESS=0.0.0.0

# Which published build to run. `latest` is the most recent merge to `main`;
# to freeze a deployment, name a commit: FATHOM_TAG=sha-<the 40-hex commit>.
# `docker compose up -d --build` ignores this and builds from the checkout.
#FATHOM_TAG=latest

# Where the operator console answers. Optional; both empty means everywhere.
# Host names your proxy forwards, comma-separated: a subdomain of the site's,
# or a domain that has nothing to do with it. Addresses or ranges the console
# may be used from, comma-separated. The site itself is served on every host;
# only /admin/* and /enrolment/operator are confined, and elsewhere they 404.
#FATHOM_ADMIN_HOSTS=admin.example.com,console.other-domain.net
#FATHOM_ADMIN_SOURCES=192.168.1.0/24,10.8.0.2

# Your reverse proxy's address or range, so the client's address is read from
# the X-Forwarded-For it writes. Unset, every client counts as the proxy: one
# sign-in rate-limit bucket for all, and the server warns. A Docker address,
# an F5's SNAT or self IP, NetBird's whole range (its proxy address changes),
# or `private` for every private, loopback, link-local and 100.64.0.0/10 peer
# -- safe only where nothing but the proxy can reach the published port.
#FATHOM_TRUSTED_PROXIES=172.18.0.5
#FATHOM_TRUSTED_PROXIES=100.64.0.0/10
# If the proxy sets another header (X-Real-IP), name it. If the proxy sits
# behind one more hop that appends to X-Forwarded-For (a CDN), count it.
#FATHOM_TRUSTED_CLIENT_IP_HEADER=X-Real-IP
#FATHOM_FORWARDED_HOPS=2
